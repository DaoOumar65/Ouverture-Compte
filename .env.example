# Authentication: all logins are validated by Active Directory.
AUTH_MODE=AD
AD_MODE=ldap
AD_HOST=192.168.10.15
AD_PORT=636
AD_TLS=ldaps
# Supported: ldaps, starttls, aucun (LDAP simple; no transport encryption).
AD_DOMAIN_NETBIOS=BCB
AD_UPN_SUFFIXES=bcb.bf,bcb.lan
AD_BASE_DN=DC=bcb,DC=lan
AD_TIMEOUT_MS=5000

# Set the internal CA certificate path if it is not trusted by the host OS.
# The certificate must identify AD_HOST. Prefer the controller FQDN if LDAPS
# certificates do not include the controller's IP address.
AD_CA_CERT=

# Add these two values only to the server's untracked .env/secret store.
# Use a read-only directory account; never commit its name or password.
AD_BIND_DN=
AD_BIND_PASSWORD=
